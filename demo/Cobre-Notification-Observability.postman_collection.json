{
  "info": {
    "_postman_id": "b8d4f5e2-0c31-4a22-9d7b-1e3f6a9c2d45",
    "name": "Cobre Notification Observability",
    "description": "Actuator en el puerto de management **8081** (no el API 8080). Sin `X-API-Key`: el filtro solo cubre `/notification_events/**`.\n\nCompose tiene que estar arriba (`docker compose up --wait`). No publiques 8081 en una red pública.\n\nOrden: health → liveness → readiness → info → metrics (catálogo) → un meter → prometheus.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "variable": [
    { "key": "managementUrl", "value": "http://localhost:8081" }
  ],
  "item": [
    {
      "name": "01 Health probes",
      "item": [
        {
          "name": "GET /actuator/health (aggregate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('UP (details hidden)', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('UP');",
                  "  pm.expect(body).to.not.have.property('components');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/health"
          }
        },
        {
          "name": "GET /actuator/health/liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('liveness UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/health/liveness"
          }
        },
        {
          "name": "GET /actuator/health/readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('readiness UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/health/readiness"
          }
        },
        {
          "name": "GET /actuator/info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/info"
          }
        }
      ]
    },
    {
      "name": "02 Micrometer (JSON)",
      "item": [
        {
          "name": "GET /actuator/metrics (names)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const names = pm.response.json().names;",
                  "pm.test('notification meters are registered', () => {",
                  "  pm.expect(names).to.include('notification.events.received');",
                  "  pm.expect(names).to.include('notification.backlog');",
                  "  pm.expect(names).to.include('notification.dlt.published');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics"
          }
        },
        {
          "name": "notification.events.received",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.events.received"
          }
        },
        {
          "name": "notification.created",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.created"
          }
        },
        {
          "name": "notification.delivery.attempts",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.delivery.attempts"
          }
        },
        {
          "name": "notification.delivery.duration",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.delivery.duration"
          }
        },
        {
          "name": "notification.retries.scheduled",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.retries.scheduled"
          }
        },
        {
          "name": "notification.failed",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.failed"
          }
        },
        {
          "name": "notification.replays",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.replays"
          }
        },
        {
          "name": "notification.processing.latency",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.processing.latency"
          }
        },
        {
          "name": "notification.dlt.published",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.dlt.published"
          }
        },
        {
          "name": "notification.backlog",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.backlog"
          }
        },
        {
          "name": "notification.backlog.oldest.age.seconds",
          "request": {
            "method": "GET",
            "url": "{{managementUrl}}/actuator/metrics/notification.backlog.oldest.age.seconds"
          }
        }
      ]
    },
    {
      "name": "03 Prometheus scrape",
      "item": [
        {
          "name": "GET /actuator/prometheus",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const text = pm.response.text();",
                  "pm.test('exposition format with notification_*', () => {",
                  "  pm.expect(text).to.include('notification_events_received');",
                  "  pm.expect(text).to.include('notification_backlog');",
                  "  pm.expect(text).to.include('notification_dlt_published');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/plain" }],
            "url": "{{managementUrl}}/actuator/prometheus"
          }
        }
      ]
    }
  ]
}
