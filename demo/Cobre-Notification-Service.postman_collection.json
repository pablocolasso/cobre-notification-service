{
  "info": {
    "_postman_id": "a7c3e4d1-9b20-4f11-8c6a-0d2e5f8a1b34",
    "name": "Cobre Notification Service",
    "description": "Authorization de la colección: **No Auth**. Cada request manda `X-API-Key` en headers. Si en Postman ponés API Key a nivel colección, el request “without API key” sigue autenticado y da 200 — no lo hagas.\n\nSi listar sin key da **200**, el contenedor es un build viejo: `docker compose up --build --wait`.\n\n**Orden:** 00 → 01 → 02 → 03 → 04 → 05. Después publicá `demo/platform-events.jsonl` y corré 06.\n\nKeys: `dev-client-001` / `002` / `003` / `dev-ops`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "client001Key", "value": "dev-client-001" },
    { "key": "client002Key", "value": "dev-client-002" },
    { "key": "client003Key", "value": "dev-client-003" },
    { "key": "opsKey", "value": "dev-ops" },
    { "key": "evt001Id", "value": "" },
    { "key": "evt003Id", "value": "" },
    { "key": "failedReplayId", "value": "" },
    { "key": "evt101Id", "value": "" },
    { "key": "evt108Id", "value": "" },
    { "key": "evt109Id", "value": "" }
  ],
  "auth": { "type": "noauth" },
  "item": [
    {
      "name": "00 Auth (401)",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List without API key → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('same code as a bad key', () => pm.expect(pm.response.json().code).to.eql('unauthorized'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "X-Request-Id", "value": "postman-no-key" }],
            "url": "{{baseUrl}}/notification_events"
          }
        },
        {
          "name": "List with wrong API key → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('same body shape', () => pm.expect(pm.response.json().code).to.eql('unauthorized'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "not-a-real-key" },
              { "key": "X-Request-Id", "value": "postman-bad-key" }
            ],
            "url": "{{baseUrl}}/notification_events"
          }
        }
      ]
    },
