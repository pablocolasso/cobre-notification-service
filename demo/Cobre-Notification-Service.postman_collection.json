                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('only CLIENT001', () => {",
                  "  pm.expect(body.items.every(i => i.client_id === 'CLIENT001')).to.be.true;",
                  "});",
                  "const evt001 = body.items.find(i => i.event_id === 'EVT001');",
                  "pm.test('fixture EVT001 is visible', () => pm.expect(evt001).to.exist);",
                  "if (evt001) {",
                  "  pm.collectionVariables.set('evt001Id', evt001.notification_event_id);",
                  "  pm.test('EVT001 completed', () => pm.expect(evt001.delivery_status).to.eql('completed'));",
