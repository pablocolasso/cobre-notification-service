              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('real HTTP attempts, not only fixture', () => {",
                  "  pm.expect(body.event_id).to.eql('EVT109');",
                  "  pm.expect(body.attempt_count).to.be.at.least(1);",
                  "});"
