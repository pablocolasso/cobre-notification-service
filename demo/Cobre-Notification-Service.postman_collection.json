                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{opsKey}}" },
              { "key": "X-Request-Id", "value": "postman-evt108" }
            ],
            "url": "{{baseUrl}}/notification_events?client_id=CLIENT002&size=20"
          }
        },
        {
          "name": "Find EVT109 (CLIENT003, wait until failed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const evt109 = pm.response.json().items.find(i => i.event_id === 'EVT109');",
                  "pm.test('EVT109 ingested', () => pm.expect(evt109).to.exist);",
                  "if (evt109) {",
                  "  pm.collectionVariables.set('evt109Id', evt109.notification_event_id);",
                  "  if (evt109.delivery_status !== 'failed') {",
                  "    console.warn('EVT109 is ' + evt109.delivery_status + ' — re-run this request after retries exhaust (~1 min)');",
                  "  }",
                  "  pm.test('failed after budget (re-run if still retrying)', () => {",
                  "    pm.expect(evt109.delivery_status).to.eql('failed');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{opsKey}}" },
              { "key": "X-Request-Id", "value": "postman-evt109" }
            ],
            "url": "{{baseUrl}}/notification_events?client_id=CLIENT003&delivery_status=failed&size=20"
          }
        },
        {
          "name": "EVT111 loan_disbursement is not created",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no EVT111 (no subscription)', () => {",
                  "  pm.expect(pm.response.json().items.some(i => i.event_id === 'EVT111')).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
